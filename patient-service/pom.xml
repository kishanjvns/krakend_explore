<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot Parent BOM (Bill of Materials)
        Manages all dependency versions for the Spring ecosystem.
        No need to specify versions for spring-boot-starter-* dependencies.
        Spring Boot guarantees they are tested and compatible together.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.trucare</groupId>
    <artifactId>patient-service</artifactId>
    <version>1.0.0</version>
    <description>TrueCare Patient Service — KrakenD Step 2</description>

    <properties>
        <!--
            Java 17 LTS. Key language features used in this project:
              Records            (JEP 395 — GA in Java 16)
              Sealed interfaces  (JEP 409 — GA in Java 17)
              Pattern matching   (JEP 394 — GA in Java 16)
              Switch expressions (JEP 361 — GA in Java 14)
              Stream.toList()    (Java 16+)
              Text blocks        (JEP 378 — GA in Java 15)
              List/Map.of()      (Java 9+)
        -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + embedded Tomcat + Jackson JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- /actuator/health for Docker & ALB health probes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Java Time (Instant, LocalDate) → ISO 8601 JSON serialisation -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- JUnit 5 + Mockito + AssertJ + Spring Test (test scope only) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Packages as an executable "fat JAR" containing all dependencies
                and an embedded Tomcat server.
                This is what "java -jar patient-service.jar" runs.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>

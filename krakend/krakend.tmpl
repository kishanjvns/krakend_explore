{
  "$schema": "https://www.krakend.io/schema/v2.7/krakend.json",
  "version": 3,
  "name": "TrueCare API Gateway — Local Dev with Keycloak",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",

  "extra_config": {
    "router": {
      "return_error_msg": true
    }
  },

  "endpoints": [
    {{ template "endpoint_patients.tmpl" . }},
    {{ template "endpoint_referrals.tmpl" . }}
  ]
}
